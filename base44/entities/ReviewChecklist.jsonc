{
  "name": "ReviewChecklist",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8"
    },
    "reviewer_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05d1\u05d5\u05d7\u05df"
    },
    "round": {
      "type": "number",
      "title": "\u05e1\u05d1\u05d1"
    },
    "item_code": {
      "type": "string",
      "title": "\u05e7\u05d5\u05d3 \u05e4\u05e8\u05d9\u05d8"
    },
    "item_label": {
      "type": "string",
      "title": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05e4\u05e8\u05d9\u05d8"
    },
    "status": {
      "type": "string",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1",
      "enum": [
        "pass",
        "fail",
        "not_applicable"
      ]
    },
    "comment": {
      "type": "string",
      "title": "\u05d4\u05e2\u05e8\u05d4"
    }
  },
  "required": [
    "project_id"
  ]
}